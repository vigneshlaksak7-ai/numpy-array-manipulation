import numpy as np

# ---------- 1. Reshaping & Flattening ----------
arr = np.array([1, 2, 3, 4, 5, 6])          # 1D array
print("Original:", arr, "| shape:", arr.shape)

reshaped = arr.reshape((2, 3))              # 2 rows, 3 columns
print("\nReshaped (2,3):\n", reshaped)

reshaped2 = arr.reshape((6, 1))             # 6 rows, 1 column
print("\nReshaped (6,1):\n", reshaped2)

flat = reshaped.flatten()                   # back to 1D (returns a copy)
print("\nFlattened:", flat)

raveled = reshaped.ravel()                  # back to 1D (returns a view when possible)
print("Raveled:", raveled)

auto = arr.reshape(3, -1)                   # -1 lets NumPy infer the columns
print("\nReshape with -1 (3,-1):\n", auto)

# ---------- 2. Stacking ----------
a = np.array([1, 2, 3])
b = np.array([4, 5, 6])

print("\nvstack:\n", np.vstack((a, b)))     # stacks as rows -> 2x3
print("hstack:", np.hstack((a, b)))         # joins end to end -> 1D of 6

# ---------- 3. Transpose ----------
t = np.array([[1, 2, 3], [4, 5, 6]])
print("\nOriginal:\n", t, "| shape:", t.shape)
print("Transpose:\n", t.T, "| shape:", t.T.shape)
